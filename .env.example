# Copy this file to .env and fill in real values locally.
# .env is git-ignored. Never commit real secrets.

# Meta (Facebook / Instagram) app
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_dm_pos

# AI service
LLM_API_KEY=

# Payment gateway: SANDBOX / TEST MODE ONLY
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---- Waymark landing page ----
# On Vercel, add these in Project -> Settings -> Environment Variables.

# Supabase project URL: Project Settings -> Data API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase SECRET key (server only, never NEXT_PUBLIC_): Project Settings -> API Keys ->
# "Secret keys" (sb_secret_...). A legacy service_role key also works via
# SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Public site URL, used for canonical links and social preview images.
NEXT_PUBLIC_SITE_URL=https://www.example.com
